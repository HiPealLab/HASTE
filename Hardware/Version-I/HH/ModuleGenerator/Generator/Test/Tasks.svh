  task automatic simulate();
    begin
      for (Irow = 0; Irow < 100; Irow = Irow + 1) begin
        for (Icol = 0; Icol < 64; Icol = Icol + 1) begin
          Nneuron = img_0_1[Irow][Icol];
          if (Nneuron == 8'd255) begin
            Icol = 64;
          end else begin
            spikeNeuron(.neuron(Nneuron));
          end
        end
        TREF(8'd1, 200);
      end
      // TREF(8'd1, 1);
      RESET();
    end
  endtask


  task automatic INIT();
    begin
      rst = 1;
      #10;
      rst = 0;
      #10;
      lay = 8'd0;
      #10;
      setlay = 1;
      #10;
      setlay = 0;
      #10;
    end
  endtask

  task automatic sendSpike();
    begin
      synEvent = 1;
      #15;
      @(posedge hhdone);
      #15;
      AERI = AERI + 8'd1;
      #10;
      synEvent = 0;
    end
  endtask

  task automatic setVolt(input [7:0] neuron, input [15:0] voltage);
    begin
      AERI = neuron;
      neuvolt = voltage;
      #15;
      vneuEvent = 1;
      #15;
      @(posedge hhdone);
      #15;
      vneuEvent = 0;
    end
  endtask

  task automatic spikeNeuron(input [7:0] neuron);
    begin
      #15;
      setVolt(.neuron(neuron), .voltage({{9'h1B2}, {7'd0}}));
      #15;
      setVolt(.neuron(neuron), .voltage(16'd0));
      #15;
    end
  endtask


  task automatic TREF(input [7:0] LAYER, times);
    begin
      repeat (times) begin
        SETLAYER(LAYER);
        trefEvent = 1'b1;
        #15;
        @(posedge hhdone);
        trefEvent = 1'b0;
        #15;
        SETLAYER(8'd0);
      end
    end
  endtask

  task automatic SETLAYER(input [7:0] LAYER);
    begin
      #20;
      lay = LAYER;
      #20;
      setlay = 1;
      #20;
      setlay = 0;
      #15;
    end
  endtask

  task automatic RESET();
    begin
      for (Irow = 64; Irow < 74; Irow = Irow + 1) begin
        setVolt(.neuron(Irow), .voltage({{9'h1B2}, {7'd0}}));
      end
    end
  endtask



