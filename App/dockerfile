FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    libx11-xcb1 \
    libxcb-xinput0 \
    libxcb1 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-sync1 \
    libxcb-xfixes0 \
    libxcb-xinerama0 \
    libxcb-xkb1 \
    libxkbcommon-x11-0 \
    libglu1-mesa \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /SNN
COPY requirements.txt .
RUN pip install -r requirements.txt
COPY . .

CMD ["python", "SNN/main.py"]
